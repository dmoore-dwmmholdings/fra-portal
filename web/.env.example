# Firebase web config (public values). Copy to .env.local, or run `firebase apps:sdkconfig web`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fra-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fra-portal
VITE_FIREBASE_APP_ID=
# Set to "true" to use local emulators (firebase emulators:start).
VITE_USE_EMULATORS=false
