rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Analyses are public read. Writes only via the MCP function (Admin SDK bypasses rules).
    match /analyses/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
